diff --git a/nginx/staging.gregor20.henemm.com.conf b/nginx/staging.gregor20.henemm.com.conf
index 4339394..b71f23a 100644
--- a/nginx/staging.gregor20.henemm.com.conf
+++ b/nginx/staging.gregor20.henemm.com.conf
@@ -74,6 +74,48 @@ server {
         proxy_set_header X-Forwarded-Proto $scheme;
     }
 
+    # MCP-Konnektor "Gregor Wetter" ohne domainweite Basic-Auth (gregor_zwanzig#3286, ADR-0128):
+    # claude.ai kann keine Basic-Auth mitschicken. Go authentifiziert fail-closed selbst
+    # (Bearer-Token je Aufruf, Konto muss in GZ_MCP_USER_IDS stehen). Exakter Pfad, damit
+    # /api/mcpx u. a. hinter der Schranke bleiben. Kein limit_req: fail2ban wuerde claude.ai
+    # aussperren (henemm-infra#397).
+    # 120 s: ein Aufruf dauert bis zu 75 s (10 s Ortssuche + 5 s Kontingent + 60 s Core).
+    location = /api/mcp {
+        auth_basic off;
+        proxy_pass http://127.0.0.1:8091;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_read_timeout 120s;
+    }
+
+    # OAuth-Endpunkte des MCP-Konnektors (gregor_zwanzig#3286): register/token ruft claude.ai
+    # serverseitig, authorize der Browser (Sitzung prueft Go, /login bleibt hinter der Schranke).
+    # X-Real-IP traegt die Registrierungsbremse in Go (20/h je IP).
+    location ^~ /api/mcp/oauth/ {
+        auth_basic off;
+        proxy_pass http://127.0.0.1:8091;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+    }
+
+    # OAuth-Metadaten (RFC 8414/9728) fuer claude.ai (gregor_zwanzig#3286): SvelteKit reicht genau
+    # drei Pfade an Go durch, alles andere unter diesem Praefix ist 404. Nur oeffentliche Angaben.
+    location ^~ /.well-known/oauth- {
+        auth_basic off;
+        proxy_pass http://127.0.0.1:3001;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+    }
+
     # Interne Endpunkte — nur fuer den Go-Prozess selbst gedacht (gregor_zwanzig#1676).
     # Staging hat zusaetzlich domainweite Basic-Auth, aber dieselbe Netzwerk-
     # Schicht wie Prod schadet nicht (Defense-in-Depth, ergaenzend zum App-Layer-
