{"bulletins":[{"publicationTime":"2026-05-01T15:00:00Z","validTime":{"startTime":"2026-05-01T15:00:00Z","endTime":"2026-05-02T15:00:00Z"},"unscheduled":false,"avalancheActivity":{"highlights":"Leichter Anstieg der Gefahr von nassen Rutschen im Tagesverlauf.","comment":"Mit der tageszeitlichen Erwärmung und der Sonneneinstrahlung steigt die Auslösebereitschaft von nassen Rutschen etwas an. Einzelne Gefahrenstellen liegen an extrem steilen Hängen in hohen Lagen."},"snowpackStructure":{"comment":"Die Schneeoberfläche gefriert tragfähig und weicht im Tagesverlauf auf. In tiefen und mittleren Lagen liegt kaum Schnee."},"tendency":[{"highlights":"Geringe Lawinengefahr.","tendencyType":"steady","validTime":{"startTime":"2026-05-02T15:00:00Z","endTime":"2026-05-03T15:00:00Z"}}],"customData":{"ALBINA":{"mainDate":"2026-05-02"},"LWD_Tyrol":{"dangerPatterns":["DP10"]}},"avalancheProblems":[],"bulletinID":"bcf44c1e-8014-496d-b728-9242252aa153","dangerRatings":[{"mainValue":"low","validTimePeriod":"all_day"}],"lang":"de","regions":[{"name":"Brandenberger Alpen","regionID":"AT-07-05"},{"name":"Kaisergebirge - Waidringer Alpen","regionID":"AT-07-06"},{"name":"Kitzbüheler Alpen Wildseeloder","regionID":"AT-07-18"},{"name":"Kitzbüheler Alpen Brixental","regionID":"AT-07-17-02"},{"name":"Kitzbüheler Alpen Wildschönau","regionID":"AT-07-17-01"}]},{"publicationTime":"2026-05-01T15:00:00Z","validTime":{"startTime":"2026-05-01T15:00:00Z","endTime":"2026-05-02T15:00:00Z"},"unscheduled":false,"avalancheActivity":{"highlights":"Leichter Anstieg der Gefahr von nassen Lawinen im Tagesverlauf.","comment":"Mit der tageszeitlichen Erwärmung und der Sonneneinstrahlung steigt die Gefahr von nassen Lawinen im Tagesverlauf etwas an. Nasse Lawinen können vereinzelt durch Personen ausgelöst werden, besonders an sehr steilen Sonnenhängen oberhalb von rund 2500 m, dies auch an sehr steilen Schattenhängen unterhalb von rund 2500 m in Rinnen und Mulden. Lawinen sind vereinzelt mittelgroß. <br/> <br/> Schw